# Acesso ao app
# Senha de login (obrigatória em produção; em dev, sem ela a senha padrão é "habitos")
APP_PASSWORD=
# Segredo para assinar a sessão (mín. 32 caracteres) — gere com: openssl rand -base64 32
AUTH_SECRET=

# Banco: Turso (SQLite na nuvem). Sem estas variáveis, usa o arquivo local ./data/habits.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lembretes por Web Push (opcional). Sem isso o app funciona e Ajustes mostra o que falta.
# Chaves VAPID — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Upstash QStash — preenchidas pela integração da Vercel ou pelo painel do Upstash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Opcional: URL pública fixa para o QStash chamar de volta (padrão: domínio de produção da Vercel)
# APP_URL=https://seu-app.vercel.app
